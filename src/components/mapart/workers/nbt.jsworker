/*
  A mapping from type names to NBT type numbers.
  This is NOT just an enum, these values have to stay as they are
  https://minecraft.wiki/w/NBT_format#TAG_definition
*/
const TagTypes = {
  end: 0,
  byte: 1,
  short: 2,
  int: 3,
  long: 4,
  float: 5,
  double: 6,
  byteArray: 7,
  string: 8,
  list: 9,
  compound: 10,
  intArray: 11,
  longArray: 12,
};

// Export NBTWriter directly
class NBTWriter {
  constructor() {
    if (typeof ArrayBuffer === "undefined") {
      throw new Error("Missing required type ArrayBuffer");
    }
    if (typeof DataView === "undefined") {
      throw new Error("Missing required type DataView");
    }
    if (typeof Uint8Array === "undefined") {
      throw new Error("Missing required type Uint8Array");
    }
    /* Will be auto-resized (x2) on write if necessary. */
    this.buffer = new ArrayBuffer(1024);

    /* These are recreated when the buffer is */
    this.dataView = new DataView(this.buffer);
    this.arrayView = new Uint8Array(this.buffer);
    this.offset = 0;
  }

  encodeUTF8(str) {
    let array = [],
      i,
      c;
    for (i = 0; i < str.length; i++) {
      c = str.charCodeAt(i);
      if (c === 0x0) {
        array.push(0xc0);
        array.push(0x80);
      } else if (c < 0x80) {
        array.push(c);
      } else if (c < 0x800) {
        array.push(0xc0 | (c >> 6));
        array.push(0x80 | (c & 0x3f));
      } else if (c < 0x10000) {
        array.push(0xe0 | (c >> 12));
        array.push(0x80 | ((c >> 6) & 0x3f));
        array.push(0x80 | (c & 0x3f));
      } else {
        // unsure if this is accurate, however we never need such exotic unicode characters
        array.push(0xf0 | ((c >> 18) & 0x07));
        array.push(0x80 | ((c >> 12) & 0x3f));
        array.push(0x80 | ((c >> 6) & 0x3f));
        array.push(0x80 | (c & 0x3f));
      }
    }
    return array;
  }

  accommodate(size) {
    // Ensures that the buffer is large enough to write `size` bytes at the current `this.offset`.
    let requiredLength = this.offset + size;
    if (this.buffer.byteLength >= requiredLength) {
      return;
    }

    let newLength = this.buffer.byteLength;
    while (newLength < requiredLength) {
      newLength *= 2;
    }
    let newBuffer = new ArrayBuffer(newLength);
    let newArrayView = new Uint8Array(newBuffer);
    newArrayView.set(this.arrayView);

    // If there's a gap between the end of the old buffer
    // and the start of the new one, we need to zero it out
    if (this.offset > this.buffer.byteLength) {
      newArrayView.fill(0, this.buffer.byteLength, this.offset);
    }

    this.buffer = newBuffer;
    this.dataView = new DataView(newBuffer);
    this.arrayView = newArrayView;
  }

  write(dataType, size, value) {
    this.accommodate(size);
    this.dataView[`set${dataType}`](this.offset, value);
    this.offset += size;
  }

  writeByType(dataType, value) {
    switch (dataType) {
      case TagTypes.end: {
        this.writeByType(TagTypes.byte, 0);
        break;
      }
      case TagTypes.byte: {
        this.write("Int8", 1, value);
        break;
      }
      case TagTypes.short: {
        this.write("Int16", 2, value);
        break;
      }
      case TagTypes.int: {
        this.write("Int32", 4, value);
        break;
      }
      case TagTypes.long: {
        // NB: special: JS doesn't support native 64 bit ints; pass an array of two 32 bit ints to this case
        this.write("Int32", 4, value[0]);
        this.write("Int32", 4, value[1]);
        break;
      }
      case TagTypes.float: {
        this.write("Float32", 4, value);
        break;
      }
      case TagTypes.double: {
        this.write("Float64", 8, value);
        break;
      }
      case TagTypes.byteArray: {
        this.writeByType(TagTypes.int, value.length);
        this.accommodate(value.length);
        this.arrayView.set(value, this.offset);
        this.offset += value.length;
        break;
      }
      case TagTypes.string: {
        let bytes = this.encodeUTF8(value);
        this.writeByType(TagTypes.short, bytes.length);
        this.accommodate(bytes.length);
        this.arrayView.set(bytes, this.offset);
        this.offset += bytes.length;
        break;
      }
      case TagTypes.list: {
        // Pass a dicitonary {"type": TagTypes.blah, "value": [] }
        this.writeByType(TagTypes.byte, value.type);
        this.writeByType(TagTypes.int, value.value.length);
        for (let i = 0; i < value.value.length; i++) {
          this.writeByType(value.type, value.value[i]);
        }
        break;
      }
      case TagTypes.compound: {
        // This is the rich tagtype we will interact with a lot
        // Pass a dictionary {"type": TagTypes.blah, "value": ... }
        // {
        //   author: { type: TagTypes.string, value: "Steve" },
        //   stuff: {
        //       type: TagTypes.compound,
        //       value: {
        //         foo: { type: int, value: 42 },
        //         bar: { type: string, value: 'Hi!' }
        //       }
        //   }
        // }
        Object.keys(value).forEach((key) => {
          this.writeByType(TagTypes.byte, value[key].type);
          this.writeByType(TagTypes.string, key);
          this.writeByType(value[key].type, value[key].value); // this is where the nice recursion happens
        });
        this.writeByType(TagTypes.end, 0);
        break;
      }
      case TagTypes.intArray: {
        this.writeByType(TagTypes.int, value.length);
        for (let i = 0; i < value.length; i++) {
          this.writeByType(TagTypes.int, value[i]);
          // https://lkml.org/lkml/2012/7/6/495
        }
        break;
      }
      case TagTypes.longArray: {
        this.writeByType(TagTypes.int, value.length);
        for (let i = 0; i < value.length; i++) {
          this.writeByType(TagTypes.long, value[i]);
          // NB this is an array of longs given as specified in case:long
        }
        break;
      }
      case "UBYTE": {
        // unsure why this is here, seems unused; nbt raw bytes (TagTypes.byte) are signed
        this.write("Uint8", 1, value);
        break;
      }
      default: {
        throw new Error(`Unknown data type ${dataType} for value ${value}`);
      }
    }
  }

  writeTopLevelCompound(value) {
    // For writing a top level JSON object as a compound tag.
    // This is of the form {"name": "blah", "value": {...}}
    // This is not just this.writeByType(TagTypes.compound, value); we add the appropriate compound prefix etc
    this.writeByType(TagTypes.byte, TagTypes.compound);
    this.writeByType(TagTypes.string, value.name);
    this.writeByType(TagTypes.compound, value.value);
  }

  getData() {
    /*
      Returns the writen data as a slice from the internal buffer, cutting off any padding at the end.
    */
    this.accommodate(0); /* make sure the offset is inside the buffer */
    return this.buffer.slice(0, this.offset);
  }
}

// Export Map_NBT
class Map_NBT {
  // Accept necessary data via constructor
  constructor(map, options) {
    // Store options needed by methods
    this.options = options; // { coloursJSON, optionValue_version, optionValue_staircasing, optionValue_whereSupportBlocks, optionValue_supportBlock, currentSelectedBlocks }
    this.coloursJSON = options.coloursJSON; // For easier access in methods

    // Keep original logic using map data
    this.mapColoursLayout = map.coloursLayout;
    this.mapMaterialsCounts = map.materials; // This seems unused currently but keep for potential future use

    // Initialize NBT JSON structure
    this.NBT_json = {
      name: "",
      value: {
        blocks: {
          type: TagTypes.list,
          value: {
            type: TagTypes.compound,
            value: [],
          },
        },
        entities: {
          type: TagTypes.list,
          value: {
            type: TagTypes.compound,
            value: [],
          },
        },
        palette: {
          type: TagTypes.list,
          value: {
            type: TagTypes.compound,
            value: [],
          },
        },
        size: {
          type: TagTypes.list,
          value: {
            type: TagTypes.int,
            value: [], // X, Y, Z
          },
        },
        author: {
          type: TagTypes.string,
          value: "rebane2001.com/mapartcraft CLI", // Updated author
        },
        DataVersion: {
          type: TagTypes.int,
          value: null,
        },
      },
    };
    this.physicalLayout = [];
    this.palette_colourSetId_paletteId = {}; // map coloursJSON colourSetIds to index of corresponding block in palette list
    this.palette_paletteId_colourSetId = []; // map paletteIds (index of an item in this list) to colourSetIds
    this.columnHeightsCache = []; // appended to in getPhysicalLayout_individualColumn, used in setNBT_json_size

    // Setup cache needed for palette construction (moved from global)
    this.exactColourCache = new Map();
    this._setupExactColourCache(); // Call helper to populate cache
  }

  // Helper method to populate exactColourCache (moved from global scope)
   _setupExactColourCache() {
    // this is for exactly matching colours, whose values are never repeated in coloursJSON
    // also RGB could be easily changed to RGBA if Mojang ever added absolute black #000000 and we need to distinguish it from transparent
    for (const [colourSetId, colourSet] of Object.entries(this.coloursJSON)) {
        for (const [toneKey, toneRGB] of Object.entries(colourSet.tonesRGB)) {
            const RGBBinary = (toneRGB[0] << 16) + (toneRGB[1] << 8) + toneRGB[2];
            this.exactColourCache.set(RGBBinary, {
                colourSetId: colourSetId,
                tone: toneKey,
            });
        }
    }
    // The original worker had a special entry for mapdat transparency,
    // which is not needed for NBT generation, so it's omitted here.
    // exactColourCache.set(0, { colourSetId: "-1", tone: "normal" });
  }

  // Helper method to check support block requirement (moved from global scope)
  _isSupportBlockMandatoryForColourSetIdAndTone(colourSetIdAndTone) {
    const blockId = this.options.currentSelectedBlocks[colourSetIdAndTone.colourSetId];
    // Handle cases where the block might not be selected (though 'Everything' preset should avoid this)
    if (blockId === undefined || blockId === "-1") return false;
    const blockData = this.coloursJSON[colourSetIdAndTone.colourSetId].blocks[blockId];
    return blockData ? blockData.supportBlockMandatory : false;
  }

  constructPaletteLookups() {
    // Use passed options
    const { currentSelectedBlocks } = this.options;
    let paletteIdCounter = 0;
    this.mapColoursLayout.forEach((column) => {
      for (const pixel of column) {
        if (!this.palette_colourSetId_paletteId.hasOwnProperty(pixel.colourSetId)) {
          this.palette_colourSetId_paletteId[pixel.colourSetId] = paletteIdCounter;
          this.palette_paletteId_colourSetId.push(pixel.colourSetId);
          paletteIdCounter++;
        }
      }
    });
    // add support block colourSetId if needed
    const { whereSupportBlocks, supportBlock } = this.options;
    // Find the colourSetId corresponding to the supportBlock NBTName
    let supportBlockColourSetId = null;
    outer_loop:
    for (const [csId, colourSet] of Object.entries(this.coloursJSON)) {
        for (const [, block] of Object.entries(colourSet.blocks)) {
            // Check NBTName across versions, assuming the name is consistent enough or fallback works
            for (const [, versionData] of Object.entries(block.validVersions)) {
                 // Handle version references like "&1.12.2" - This part needs careful handling
                 // For simplicity, let's assume direct NBTName match for now.
                 // A more robust solution would resolve these references based on the target version.
                 if (typeof versionData === 'object' && versionData.NBTName === supportBlock) {
                     supportBlockColourSetId = csId;
                     break outer_loop;
                 }
            }
        }
    }

    if (supportBlockColourSetId && whereSupportBlocks !== this.options.WhereSupportBlocksModes.NONE.uniqueId && !this.palette_colourSetId_paletteId.hasOwnProperty(supportBlockColourSetId)) {
      this.palette_colourSetId_paletteId[supportBlockColourSetId] = paletteIdCounter;
      this.palette_paletteId_colourSetId.push(supportBlockColourSetId);
      paletteIdCounter++;
    }
  }

  setNBT_json_palette() {
    // Use passed options
    const { currentSelectedBlocks, optionValue_version } = this.options;
    this.palette_paletteId_colourSetId.forEach((colourSetId) => {
      let paletteItemToPush = {};
      if (colourSetId === "-1") {
        paletteItemToPush.Name = {
          type: TagTypes.string,
          value: "minecraft:air",
        };
      } else {
        // Find the selected block ID for this colourSetId
        const selectedBlockId = currentSelectedBlocks[colourSetId];
        if (!selectedBlockId || selectedBlockId === "-1") {
           console.warn(`No block selected for colourSetId ${colourSetId}, skipping palette entry.`);
           return; // Skip this palette entry if no block is selected
        }

        // Find the block data for the selected block and version
        const blockSet = this.coloursJSON[colourSetId].blocks[selectedBlockId];
        if (!blockSet) {
            console.warn(`Block data not found for colourSetId ${colourSetId}, blockId ${selectedBlockId}. Skipping palette entry.`);
            return;
        }

        let blockNBTData = blockSet.validVersions[optionValue_version.MCVersion];

        // Resolve version references (e.g., "&1.12.2")
        while (typeof blockNBTData === "string" && blockNBTData.startsWith('&')) {
            const referencedVersion = blockNBTData.slice(1);
            blockNBTData = blockSet.validVersions[referencedVersion];
            if (!blockNBTData) {
                 console.warn(`Could not resolve version reference '${blockNBTData}' for ${colourSetId}, blockId ${selectedBlockId}. Skipping palette entry.`);
                 return; // Cannot resolve reference
            }
        }

        if (!blockNBTData || typeof blockNBTData !== 'object') {
             console.warn(`NBT data not found or invalid for ${colourSetId}, blockId ${selectedBlockId}, version ${optionValue_version.MCVersion}. Skipping palette entry.`);
             return;
        }

        paletteItemToPush.Name = {
          type: TagTypes.string,
          value: `minecraft:${blockNBTData.NBTName}`,
        };
        if (Object.keys(blockNBTData.NBTArgs).length !== 0) {
          paletteItemToPush.Properties = { type: TagTypes.compound, value: {} };
          Object.keys(blockNBTData.NBTArgs).forEach((NBTArg_key) => {
            paletteItemToPush.Properties.value[NBTArg_key] = {
              type: TagTypes.string,
              value: blockNBTData.NBTArgs[NBTArg_key],
            };
          });
        }
      }
      this.NBT_json.value.palette.value.value.push(paletteItemToPush);
    });
  }

  setNBT_json_DataVersion() {
    // Use passed option
    this.NBT_json.value.DataVersion.value = this.options.optionValue_version.NBTVersion;
  }

  returnPhysicalBlock(x, y, z, colourSetId) {
    return {
      pos: { type: TagTypes.list, value: { type: TagTypes.int, value: [x, y, z] } },
      state: { type: TagTypes.int, value: this.palette_colourSetId_paletteId[colourSetId] },
    };
  }

  getPhysicalLayout() {
    for (let columnNumber = 0; columnNumber < this.mapColoursLayout.length; columnNumber++) {
      this.getPhysicalLayout_individualColumn(columnNumber);
    }
  }

  getPhysicalLayout_individualColumn(columnNumber) {
    // Use passed options
    const { optionValue_staircasing, optionValue_whereSupportBlocks, supportBlock } = this.options;
    let heightCache = []; // y coordinate of highest block placed in this column
    let column = this.mapColoursLayout[columnNumber];

    // Find the colourSetId for the support block (similar logic to constructPaletteLookups, could be optimized)
    let supportBlockColourSetId = null;
     outer_loop:
    for (const [csId, colourSet] of Object.entries(this.coloursJSON)) {
        for (const [, block] of Object.entries(colourSet.blocks)) {
             for (const [, versionData] of Object.entries(block.validVersions)) {
                 if (typeof versionData === 'object' && versionData.NBTName === supportBlock) {
                     supportBlockColourSetId = csId;
                     break outer_loop;
                 }
            }
        }
    }

    // --- BEGIN SUPPORT BLOCK LOGIC ---
    // Compare directly with the option ID
    const allModeId = this.options.WhereSupportBlocksModes?.ALL?.uniqueId;
    if (optionValue_whereSupportBlocks === allModeId && supportBlockColourSetId) {
      // Add full layer of support blocks at y=0
      for (let rowNumber = 0; rowNumber < column.length; rowNumber++) {
        this.NBT_json.value.blocks.value.value.push(this.returnPhysicalBlock(columnNumber, 0, rowNumber, supportBlockColourSetId));
        heightCache[rowNumber] = 0;
      }
    } else {
      for (let rowNumber = 0; rowNumber < column.length; rowNumber++) {
        heightCache[rowNumber] = -1; // Initialise all heights to -1
      }
    }
    // --- END SUPPORT BLOCK LOGIC ---

    // --- BEGIN MAIN LOOP ---
    for (let rowNumber = 0; rowNumber < column.length; rowNumber++) {
      const pixel = column[rowNumber];

      if (pixel.colourSetId !== "-1") {
        // Only process non-transparent pixels
        let y;
        switch (optionValue_staircasing) {
          case this.options.MapModes.SCHEMATIC_NBT.staircaseModes.OFF.uniqueId:
            y = 0;
            break;
          case this.options.MapModes.SCHEMATIC_NBT.staircaseModes.CLASSIC.uniqueId:
          case this.options.MapModes.SCHEMATIC_NBT.staircaseModes.VALLEY.uniqueId:
            switch (pixel.tone) {
              case "dark":
                y = 0;
                break;
              case "normal":
                y = 1;
                break;
              case "light":
                y = 2;
                break;
              default:
                throw new Error("Unknown colour tone for SCHEMATIC_NBT staircasing");
            }
            break;
           // Add cases for FULL_DARK, FULL_LIGHT if needed, based on MapModes.json
           case this.options.MapModes.SCHEMATIC_NBT.staircaseModes.FULL_DARK.uniqueId:
             y = 0; // Assuming dark maps to lowest level
             break;
           case this.options.MapModes.SCHEMATIC_NBT.staircaseModes.FULL_LIGHT.uniqueId:
             y = 0; // Assuming light maps to lowest level (adjust if needed)
             break;
          default:
            throw new Error("Unknown staircasing mode");
        }

        // --- BEGIN VALLEY ADJUSTMENT ---
        if (optionValue_staircasing === this.options.MapModes.SCHEMATIC_NBT.staircaseModes.VALLEY.uniqueId) {
          let neighbourHeights = [];
          if (columnNumber !== 0) {
            neighbourHeights.push(heightCache[rowNumber]); // west
          }
          if (columnNumber !== this.mapColoursLayout.length - 1) {
            // east requires lookahead, this is tricky without full heightmap first
            // For simplicity, we'll only look west and north for valley calculation.
            // A more accurate implementation would require a two-pass approach or pre-calculating the full heightmap.
          }
          if (rowNumber !== 0) {
            // north // Check previous row's height *in this column*
             const northPixel = this.mapColoursLayout[columnNumber][rowNumber - 1];
             let northY;
             if (northPixel.colourSetId !== "-1") {
                 switch (northPixel.tone) {
                      case "dark": northY = 0; break;
                      case "normal": northY = 1; break;
                      case "light": northY = 2; break;
                      default: northY = -1; // Should not happen with valid data
                 }
                 neighbourHeights.push(northY);
             } else {
                 neighbourHeights.push(-1); // Treat transparent neighbors as lowest possible
             }
          }
          if (rowNumber !== column.length - 1) {
             // south requires lookahead
          }

          if (neighbourHeights.length > 0) {
            const lowestNeighbour = Math.min(...neighbourHeights.filter(h => h !== -1)); // Filter out uninitialized neighbours
            if (lowestNeighbour !== Infinity && y > lowestNeighbour) {
                y = lowestNeighbour; // Set to lowest neighbour's height if higher
            }
          }
        }
        // --- END VALLEY ADJUSTMENT ---


        // Push the main block for this pixel
        this.NBT_json.value.blocks.value.value.push(this.returnPhysicalBlock(columnNumber, y, rowNumber, pixel.colourSetId));
        const currentHeight = heightCache[rowNumber]; // Height *before* placing this block
        heightCache[rowNumber] = Math.max(currentHeight, y); // Update heightmap

        // --- BEGIN SUPPORT BLOCK LOGIC (underneath mandatory blocks) ---
        const allOptimizedModeId = this.options.WhereSupportBlocksModes?.ALL_OPTIMIZED?.uniqueId;
        const mandatoryOnlyModeId = this.options.WhereSupportBlocksModes?.MANDATORY_ONLY?.uniqueId;
        if (
          supportBlockColourSetId &&
          // Compare directly with the option ID
          (optionValue_whereSupportBlocks === allOptimizedModeId ||
           optionValue_whereSupportBlocks === mandatoryOnlyModeId) &&
          this._isSupportBlockMandatoryForColourSetIdAndTone(pixel)
        ) {
           // Place support blocks from y-1 down to the higher of 0 or currentHeight+1
           const startSupportY = y - 1;
           // Compare directly with the option ID
           const endSupportY = (optionValue_whereSupportBlocks === mandatoryOnlyModeId)
                             ? startSupportY // Only place directly underneath if MANDATORY_ONLY
                             : Math.max(0, currentHeight + 1); // Fill gap down to previous block or y=0 if ALL_OPTIMIZED


           for (let supportY = startSupportY; supportY >= endSupportY; supportY--) {
             // Check if a block already exists at this support position (unlikely but possible with complex staircasing/valleys)
             // This check is computationally expensive. A simpler approach is to just add, letting Minecraft handle overlaps if any.
             // For now, we'll add without checking.
             this.NBT_json.value.blocks.value.value.push(this.returnPhysicalBlock(columnNumber, supportY, rowNumber, supportBlockColourSetId));
             heightCache[rowNumber] = Math.max(heightCache[rowNumber], supportY); // Ensure heightmap reflects support blocks
           }
        }
        // --- END SUPPORT BLOCK LOGIC ---
      } else {
        // Handle transparent pixel ('-1') - potentially place support block if needed
        if (
             supportBlockColourSetId &&
             // Compare directly with the option ID (use the variable defined above)
             optionValue_whereSupportBlocks === allModeId
            // ALL_OPTIMIZED should not place support under transparent pixels unless filling gaps, which is handled above.
            // MANDATORY_ONLY never places support under transparent.
        ) {
             // Already placed at y=0 if ALL mode was selected
             // No action needed here for transparent pixels in most cases,
             // unless a specific rule requires filling under transparent based on neighbours.
        }
      }
    }
    // --- END MAIN LOOP ---

    // Add highest height in this column to cache for final size calculation
    this.columnHeightsCache.push(Math.max(...heightCache.filter(h => h !== -1), -1) ); // Use -1 if column was empty/transparent
  }

  setNBT_json_blocks() {
    this.getPhysicalLayout();
  }

  setNBT_json_size() {
    // --- BEGIN SIZE ADJUSTMENT ---
    const height = this.columnHeightsCache.reduce((a, b) => (a > b ? a : b)) + 1;
    // Always output 16x16 for X and Z in NBT Schematics
    this.NBT_json.value.size.value.value = [
      16,
      height, 
      16
    ];
    // --- END SIZE ADJUSTMENT ---
  }

  getNBT() {
    this.constructPaletteLookups();
    this.setNBT_json_palette();
    this.setNBT_json_DataVersion();
    this.setNBT_json_blocks();
    this.setNBT_json_size();

    // console.log(NBT_json);

    let nbtWriter = new NBTWriter();
    nbtWriter.writeTopLevelCompound(this.NBT_json);
    return nbtWriter.getData();
  }
}

// Export constants needed from MapModes/WhereSupportBlocksModes if used in constructor/options
// It's better practice to pass the uniqueId values in the options object though.
module.exports = {
  NBTWriter,
  Map_NBT,
  TagTypes, // Export TagTypes if needed externally
  // Also export constants needed from MapModes/WhereSupportBlocksModes if used in constructor/options
  // It's better practice to pass the uniqueId values in the options object though.
};
