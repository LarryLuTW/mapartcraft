/*
  'maps' is a matrix with entries accessable via maps[z][x], each of which corresponds to a 128x128 map (or 16x16 for NBT).
*/

// rgb2lab conversion based on the one from redstonehelper's program
function rgb2lab(rgb, labCache) {
  let val = (rgb[0] << 16) + (rgb[1] << 8) + rgb[2];
  if (labCache.has(val)) return labCache.get(val);

  let r1 = rgb[0] / 255.0;
  let g1 = rgb[1] / 255.0;
  let b1 = rgb[2] / 255.0;

  r1 = 0.04045 >= r1 ? (r1 /= 12.0) : Math.pow((r1 + 0.055) / 1.055, 2.4);
  g1 = 0.04045 >= g1 ? (g1 /= 12.0) : Math.pow((g1 + 0.055) / 1.055, 2.4);
  b1 = 0.04045 >= b1 ? (b1 /= 12.0) : Math.pow((b1 + 0.055) / 1.055, 2.4);
  let f = (0.43605202 * r1 + 0.3850816 * g1 + 0.14308742 * b1) / 0.964221,
    h = 0.22249159 * r1 + 0.71688604 * g1 + 0.060621485 * b1,
    k = (0.013929122 * r1 + 0.097097 * g1 + 0.7141855 * b1) / 0.825211,
    l = 0.008856452 < h ? Math.pow(h, 1 / 3) : (903.2963 * h + 16.0) / 116.0,
    m = 500.0 * ((0.008856452 < f ? Math.pow(f, 1 / 3) : (903.2963 * f + 16.0) / 116.0) - l),
    n = 200.0 * (l - (0.008856452 < k ? Math.pow(k, 1 / 3) : (903.2963 * k + 16.0) / 116.0));

  rgb = [2.55 * (116.0 * l - 16.0) + 0.5, m + 0.5, n + 0.5];
  labCache.set(val, rgb);
  return rgb;
}

function squaredEuclideanMetricColours(pixel1, pixel2, optionValue_betterColour, labCache) {
  if (optionValue_betterColour) {
    // Use passed labCache
    pixel1 = rgb2lab(pixel1, labCache);
    pixel2 = rgb2lab(pixel2, labCache);
  }
  const r = pixel1[0] - pixel2[0];
  const g = pixel1[1] - pixel2[1];
  const b = pixel1[2] - pixel2[2];
  return r * r + g * g + b * b; // actually L*a*b* if optionValue_betterColour but metric is calculated the same
}

function findClosestColourSetIdAndToneAndRGBTo(pixelRGB, colourSetsToUse, colourCache, optionValue_betterColour, labCache) {
  let RGBBinary = (pixelRGB[0] << 16) + (pixelRGB[1] << 8) + pixelRGB[2]; // injective mapping RGB to concatenated binaries
  if (colourCache.has(RGBBinary)) {
    return colourCache.get(RGBBinary);
  } else {
    let shortestDistance = 9999999;
    let closestPixel;

    colourSetsToUse.forEach((colourSet) => {
      Object.keys(colourSet.tonesRGB).forEach((toneKey) => {
        const toneRGB = colourSet.tonesRGB[toneKey];
        let squareDistance = squaredEuclideanMetricColours(toneRGB, pixelRGB, optionValue_betterColour, labCache);
        if (squareDistance < shortestDistance) {
          shortestDistance = squareDistance;
          closestPixel = {
            colourSetId: colourSet.colourSetId,
            tone: toneKey,
          };
        }
      });
    });
    colourCache.set(RGBBinary, closestPixel);
    return closestPixel;
  }
}

function findClosest2ColourSetIdAndToneAndRGBTo(pixelRGB, colourSetsToUse, colourCache, optionValue_betterColour, labCache, coloursJSON) {
  let RGBBinary = (pixelRGB[0] << 16) + (pixelRGB[1] << 8) + pixelRGB[2];
  if (colourCache.has(RGBBinary)) {
    return colourCache.get(RGBBinary);
  } else {
    let shortestDistance1 = 9999999;
    let shortestDistance2 = 9999999;
    let closestPixel1 = { colourSetId: null, tone: null }; // best colour
    let closestPixel2 = { colourSetId: null, tone: null }; // second best colour

    colourSetsToUse.forEach((colourSet) => {
      Object.keys(colourSet.tonesRGB).forEach((toneKey) => {
        const toneRGB = colourSet.tonesRGB[toneKey];
        let squareDistance = squaredEuclideanMetricColours(toneRGB, pixelRGB, optionValue_betterColour, labCache);
        if (squareDistance < shortestDistance1) {
          shortestDistance1 = squareDistance;
          closestPixel1 = {
            colourSetId: colourSet.colourSetId,
            tone: toneKey,
          };
        }
        if (squareDistance < shortestDistance2 && colourSetIdAndToneToRGB(closestPixel1.colourSetId, closestPixel1.tone, coloursJSON) !== toneRGB) {
          shortestDistance2 = squareDistance;
          closestPixel2 = {
            colourSetId: colourSet.colourSetId,
            tone: toneKey,
          };
        }
      });
    });
    if (
      shortestDistance2 !== 9999999 && // to make sure closestPixel2.colourSetId/tone is not null
      squaredEuclideanMetricColours(
        colourSetIdAndToneToRGB(closestPixel1.colourSetId, closestPixel1.tone, coloursJSON),
        colourSetIdAndToneToRGB(closestPixel2.colourSetId, closestPixel2.tone, coloursJSON),
        optionValue_betterColour,
        labCache
      ) <= shortestDistance2
    ) {
      closestPixel2 = closestPixel1; // if closestPixel1 is a better fit to closestPixel2 than closestPixel2 is to the actual pixel
    }
    let newPixels = [shortestDistance1, shortestDistance2, closestPixel1, closestPixel2];
    colourCache.set(RGBBinary, newPixels);
    return newPixels;
  }
}

function setupColourSetsToUse(selectedBlocks, MapModes, optionValue_modeNBTOrMapdat, optionValue_staircasing, coloursJSON) {
  let colourSetsToUse = []; // Initialize locally
  let colourSetIdsToUse = []; // get selected colour sets
  Object.keys(selectedBlocks).forEach((key) => {
    if (selectedBlocks[key] !== "-1") {
      colourSetIdsToUse.push(key);
    }
  });

  // now get appropriate shades
  const toneKeys = Object.values(Object.values(MapModes).find((mapMode) => mapMode.uniqueId === optionValue_modeNBTOrMapdat).staircaseModes).find(
    (staircaseMode) => staircaseMode.uniqueId === optionValue_staircasing
  ).toneKeys;

  for (const colourSetId of colourSetIdsToUse) {
    let tonesRGB = {};
    for (const toneKey of toneKeys) {
      tonesRGB[toneKey] = coloursJSON[colourSetId].tonesRGB[toneKey];
    }
    colourSetsToUse.push({
      colourSetId: colourSetId,
      tonesRGB: tonesRGB,
    });
  }
  return colourSetsToUse; // Return the generated list
}

function setupExactColourCache(coloursJSON) {
  const exactColourCache = new Map(); // Initialize locally
  // we do not care what staircasing option is selected etc as this does not matter
  // this is for exactly matching colours, whose values are never repeated in coloursJSON
  for (const [colourSetId, colourSet] of Object.entries(coloursJSON)) {
    for (const [toneKey, toneRGB] of Object.entries(colourSet.tonesRGB)) {
      const RGBBinary = (toneRGB[0] << 16) + (toneRGB[1] << 8) + toneRGB[2];
      exactColourCache.set(RGBBinary, {
        colourSetId: colourSetId,
        tone: toneKey,
      });
    }
  }
  return exactColourCache; // Return the generated cache
}

function exactRGBToColourSetIdAndTone(pixelRGB, exactColourCache) {
  const RGBBinary = (pixelRGB[0] << 16) + (pixelRGB[1] << 8) + pixelRGB[2];
  return exactColourCache.get(RGBBinary);
}

function colourSetIdAndToneToRGB(colourSetId, tone, coloursJSON) {
  // Handle potential null/undefined colourSetId or tone gracefully
  if (!colourSetId || !tone || !coloursJSON[colourSetId] || !coloursJSON[colourSetId]["tonesRGB"] || !coloursJSON[colourSetId]["tonesRGB"][tone]) {
      // console.warn(`Could not find RGB for colourSetId: ${colourSetId}, tone: ${tone}`);
      return [0, 0, 0]; // Return black or some default if lookup fails
  }
  return coloursJSON[colourSetId]["tonesRGB"][tone];
}

// Main exported function
function processImageData(imageData, width, height, options) {
  // Destructure options for clarity
  const {
    coloursJSON,
    MapModes,
    WhereSupportBlocksModes, // Needed? Maybe not directly here
    DitherMethods,
    selectedBlocks,
    optionValue_modeNBTOrMapdat,
    // optionValue_mapSize_x, // These are implicit in the 16x16 input for NBT
    // optionValue_mapSize_y,
    optionValue_staircasing,
    // optionValue_whereSupportBlocks, // Used in nbt.js
    optionValue_transparency, // Needed for mapdat only
    optionValue_transparencyTolerance, // Needed for mapdat only
    optionValue_betterColour,
    optionValue_dithering
  } = options;

  // Initialize state for this call
  const labCache = new Map();
  const colourCache = new Map(); // For findClosest...
  const exactColourCache = setupExactColourCache(coloursJSON);
  const colourSetsToUse = setupColourSetsToUse(selectedBlocks, MapModes, optionValue_modeNBTOrMapdat, optionValue_staircasing, coloursJSON);

  let maps = []; // Will hold the output structure for Map_NBT

  // Input imageData is expected to be a flat RGBA buffer (e.g., from sharp)
  // Input width and height are expected to be 16x16 for NBT mode

  // --- MAPS INIT --- (Simplified for NBT, assuming 1x1 map structure)
  if (optionValue_modeNBTOrMapdat === MapModes.SCHEMATIC_NBT.uniqueId) {
    let mapEntryToAdd = { materials: {}, supportBlockCount: 0 }; // supportBlockCount might not be used by NBT side
    colourSetsToUse.forEach((colourSet) => {
      mapEntryToAdd.materials[colourSet.colourSetId] = 0;
    });
    maps.push([mapEntryToAdd]); // Single 1x1 map structure
  } else {
    // Add mapdat init logic here if needed for CLI mapdat generation later
    console.error("Mapdat generation not yet fully supported in CLI mode.");
    return null; // Or handle mapdat initialization
  }
  // --- END MAPS INIT ---

  if (colourSetsToUse.length === 0) {
    console.warn("No block colours available based on selection. Cannot process image.");
    return { processedPixels: imageData, maps: maps }; // Return empty/original data
  }

  // --- REMOVED RESIZE LOGIC --- Resizing (to 16x16 for NBT) should happen *before* calling this function.
  // The input `imageData`, `width`, `height` should already be 16x16.

  if (optionValue_modeNBTOrMapdat !== MapModes.SCHEMATIC_NBT.uniqueId) {
     console.error("Only NBT Schematic generation (16x16) is currently supported.");
     return null;
  }

  // --- IMAGE PROCESSING LOOP ---
  // Create a new buffer for the output pixels (where colors match Minecraft blocks)
  const outputPixelData = Buffer.alloc(imageData.length);
  imageData.copy(outputPixelData); // Start with a copy

  // Dithering setup
  let ditherMatrix;
  let divisor;
  const chosenDitherMethod =
    Object.values(DitherMethods).find((ditherMethod) => ditherMethod.uniqueId === optionValue_dithering);

  if (!chosenDitherMethod) {
      console.warn(`Unknown dithering method ID: ${optionValue_dithering}. Defaulting to None.`);
      chosenDitherMethod = DitherMethods.None;
  }

  if (chosenDitherMethod.uniqueId !== DitherMethods.None.uniqueId) {
    ditherMatrix = chosenDitherMethod.ditherMatrix;
  }
  if (
    chosenDitherMethod.ditherDivisor // Check if divisor exists
  ) {
    divisor = chosenDitherMethod.ditherDivisor;
  }

  const errorDiffusionMatrix = new Array(height).fill(0).map(() => new Array(width).fill(0).map(() => [0, 0, 0]));

  for (let y = 0; y < height; y++) {
    for (let x = 0; x < width; x++) {
        const index = (y * width + x) * 4;
        const indexR = index;
        const indexG = index + 1;
        const indexB = index + 2;
        const indexA = index + 3; // Alpha channel

        // For NBT, we ignore transparency options from the UI.
        // Assume fully opaque input or treat transparent as black/a default?
        // For now, process RGB directly.
        // TODO: Decide how to handle input alpha for NBT. Map to air? Choose closest non-air?

        let oldPixel = [
            imageData[indexR],
            imageData[indexG],
            imageData[indexB],
        ];

        // Apply error diffusion from neighbours
        if (chosenDitherMethod.ditherDivisor) { // Only apply if error diffusion type
             oldPixel[0] = Math.max(0, Math.min(255, oldPixel[0] + errorDiffusionMatrix[y][x][0]));
             oldPixel[1] = Math.max(0, Math.min(255, oldPixel[1] + errorDiffusionMatrix[y][x][1]));
             oldPixel[2] = Math.max(0, Math.min(255, oldPixel[2] + errorDiffusionMatrix[y][x][2]));
        }


        let closestColourSetIdAndTone;

        switch (chosenDitherMethod.uniqueId) {
          case DitherMethods.None.uniqueId: {
            closestColourSetIdAndTone = findClosestColourSetIdAndToneAndRGBTo(oldPixel, colourSetsToUse, colourCache, optionValue_betterColour, labCache);
            break;
          }
          case DitherMethods.Bayer44.uniqueId:
          case DitherMethods.Bayer22.uniqueId:
          case DitherMethods.Ordered33.uniqueId: {
            const newPixels = findClosest2ColourSetIdAndToneAndRGBTo(oldPixel, colourSetsToUse, colourCache, optionValue_betterColour, labCache, coloursJSON);
            // newPixels = [shortestDistance1, shortestDistance2, newPixel1, newPixel2]
            if (newPixels[1] === 0 || newPixels[0] === Infinity || newPixels[1] === Infinity) { // Avoid division by zero or using Infinity
                 closestColourSetIdAndTone = newPixels[2]; // Default to the absolute closest
            } else if (
              (newPixels[0] * (ditherMatrix[0].length * ditherMatrix.length + 1)) / newPixels[1] >
              ditherMatrix[x % ditherMatrix[0].length][y % ditherMatrix.length] // Use x, y for matrix lookup
            ) {
              closestColourSetIdAndTone = newPixels[3];
            } else {
              closestColourSetIdAndTone = newPixels[2];
            }
            break;
          }
          // Error diffusion algorithms
          default: { // Handles FloydSteinberg, MinAvgErr, Burkes, etc.
             if (!chosenDitherMethod.ditherDivisor || !chosenDitherMethod.ditherMatrix) {
                 // Fallback to None if matrix/divisor missing for error diffusion type
                 console.warn(`Dithering config missing for ${chosenDitherMethod.uniqueId}. Using None.`);
                 closestColourSetIdAndTone = findClosestColourSetIdAndToneAndRGBTo(oldPixel, colourSetsToUse, colourCache, optionValue_betterColour, labCache);
             } else {
                 closestColourSetIdAndTone = findClosestColourSetIdAndToneAndRGBTo(oldPixel, colourSetsToUse, colourCache, optionValue_betterColour, labCache);
                 const newPixel = colourSetIdAndToneToRGB(closestColourSetIdAndTone.colourSetId, closestColourSetIdAndTone.tone, coloursJSON);
                 const quantError = [
                     oldPixel[0] - newPixel[0],
                     oldPixel[1] - newPixel[1],
                     oldPixel[2] - newPixel[2],
                 ];

                 // Distribute error
                 for (let dmY = 0; dmY < ditherMatrix.length; dmY++) {
                     for (let dmX = 0; dmX < ditherMatrix[dmY].length; dmX++) {
                          const offset = chosenDitherMethod.matrixOffset || [0, 0]; // Assume offset [0,0] if not defined
                          const neighbourX = x + dmX - offset[0];
                          const neighbourY = y + dmY - offset[1];

                          if (neighbourX >= 0 && neighbourX < width && neighbourY >= 0 && neighbourY < height && ditherMatrix[dmY][dmX] !== 0) {
                               const errorFactor = ditherMatrix[dmY][dmX] / divisor;
                               errorDiffusionMatrix[neighbourY][neighbourX][0] += quantError[0] * errorFactor;
                               errorDiffusionMatrix[neighbourY][neighbourX][1] += quantError[1] * errorFactor;
                               errorDiffusionMatrix[neighbourY][neighbourX][2] += quantError[2] * errorFactor;
                          }
                     }
                 }
             }
             break;
          }
        }

        // Ensure we got a valid colour/tone
        if (!closestColourSetIdAndTone || !closestColourSetIdAndTone.colourSetId) {
             console.warn(`Could not determine closest colour for pixel at (${x}, ${y}). Setting to black.`);
             outputPixelData[indexR] = 0;
             outputPixelData[indexG] = 0;
             outputPixelData[indexB] = 0;
             outputPixelData[indexA] = 255; // Keep opaque
        } else {
             const closestColourRGB = colourSetIdAndToneToRGB(closestColourSetIdAndTone.colourSetId, closestColourSetIdAndTone.tone, coloursJSON);

             // Update the output buffer with the chosen Minecraft block colour
             outputPixelData[indexR] = closestColourRGB[0];
             outputPixelData[indexG] = closestColourRGB[1];
             outputPixelData[indexB] = closestColourRGB[2];
             outputPixelData[indexA] = 255; // Keep opaque

             // Update materials count for the map (assuming only one map for NBT)
             if (maps[0] && maps[0][0] && maps[0][0].materials.hasOwnProperty(closestColourSetIdAndTone.colourSetId)) {
                 maps[0][0].materials[closestColourSetIdAndTone.colourSetId]++;
             }
        }
    }
     // Remove progress reporting for rows
     // postMessage({ head: "PROGRESS_REPORT", body: (y + 1) / height });
  }

  // Return the processed pixel data (as RGBA buffer) and the maps structure
  return {
    processedPixels: outputPixelData,
    maps: maps,
  };
}

// --- Add Exports ---
module.exports = {
  processImageData,
  // Export helpers if they might be useful externally?
  // rgb2lab,
  // squaredEuclideanMetricColours,
